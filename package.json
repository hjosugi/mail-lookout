{
  "name": "mail-lookout",
  "version": "1.1.17",
  "description": "A send-confirmation add-in for the new Outlook. It uses Smart Alerts to help prevent misdelivery.",
  "keywords": [
    "email",
    "office-addin",
    "outlook",
    "send-confirmation",
    "smart-alerts"
  ],
  "homepage": "https://avishaikofun.com",
  "bugs": {
    "url": "https://github.com/hjosugi/mail-lookout/issues"
  },
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjosugi/mail-lookout.git"
  },
  "type": "module",
  "scripts": {
    "dev-certs": "office-addin-dev-certs install",
    "dev": "vite",
    "dev:emulator": "vite --open /emulator.html",
    "dev:outlook": "vite --port 3000 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build && bun scripts/generate-manifest.js",
    "deploy:cloudflare": "bun run build && bun run deploy:cloudflare:artifact",
    "deploy:cloudflare:artifact": "bun scripts/deploy-cloudflare.js",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "icons": "bun scripts/make-icons.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "heartbeat": "bun scripts/heartbeat.js",
    "validate": "bun scripts/validate-manifest.js manifest.xml",
    "version:patch": "bun scripts/release-version.js patch",
    "version:minor": "bun scripts/release-version.js minor",
    "version:major": "bun scripts/release-version.js major",
    "version:set": "bun scripts/release-version.js",
    "version:bump": "bun scripts/bump-version.js",
    "release:tag": "bun scripts/release-tag.js",
    "prepare": "git config core.hooksPath .githooks",
    "check": "oxlint . && oxfmt --check . && bun run typecheck && bun run test:coverage && bun run build",
    "check:publish": "bun run check && bun run validate && bun run heartbeat",
    "graphify:setup": "sh scripts/graphify.sh setup",
    "graphify:update": "sh scripts/graphify.sh update"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/office-js": "^1.0.614",
    "@vitest/coverage-v8": "^4.1.12",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-manifest": "^2.1.6",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "4.136.3"
  },
  "overrides": {
    "@vitest/mocker@>=4.0.0 <4.1.12": "4.1.12",
    "adm-zip@>=0.0.0 <0.6.1": "0.6.1",
    "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
    "nanoid@>=3.0.0 <3.3.18": "3.3.20",
    "postcss@>=8.0.0 <8.5.23": "8.5.31",
    "sharp@>=0.0.0 <0.35.5": "0.35.5",
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
    "tinypool@>=2.0.0 <2.1.2": "2.2.0",
    "undici@>=7.0.0 <7.30.1": "7.30.1"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
